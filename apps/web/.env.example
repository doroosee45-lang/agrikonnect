# AGRIKONNECT AFRICA — application web (React + Vite)
# Copier ce fichier en .env puis renseigner. Ne jamais versionner le .env réel.

# URL de base de l'API backend. À renseigner.
# En développement local, le backend écoute sur http://localhost:4000.
VITE_API_BASE_URL=

# URL du canal temps réel (Supabase Realtime). À renseigner.
# Laisser vide si le temps réel n'est pas utilisé.
VITE_REALTIME_URL=
