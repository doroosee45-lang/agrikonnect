# AGRIKONNECT AFRICA — application mobile (Expo / React Native)
# Copier ce fichier en .env puis renseigner. Ne jamais versionner le .env réel.
# Les variables EXPO_PUBLIC_* sont injectées dans le bundle : n'y mettre AUCUN secret.

# URL de base de l'API backend. À renseigner.
# Depuis un téléphone physique, localhost ne fonctionne pas : utiliser l'adresse
# LAN de la machine qui fait tourner le backend (ex. http://192.168.1.20:4000).
EXPO_PUBLIC_API_BASE_URL=

# URL du canal temps réel (Supabase Realtime). À renseigner.
EXPO_PUBLIC_REALTIME_URL=
