# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Temps réel Socket.IO (messagerie) — chemin /realtime
REALTIME_ENABLED=true

# Tâches planifiées internes (expirations, SLO litiges, purges)
JOBS_ENABLED=true
ORDER_RESPONSE_DAYS=7
DISPUTE_SLA_DAYS=5
# Périodicité du balayage d'expiration des annonces du marché (minutes)
LISTING_EXPIRY_MINUTES=5

# ─── Authentification multifacteur (V4 NFR-01) ─────────────────
# Clé de chiffrement AES-256-GCM des secrets TOTP. OBLIGATOIRE en production :
# sans elle, l'API refuse de générer un secret MFA (SEC-08).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
MFA_ENCRYPTION_KEY=

# ─── Canal WhatsApp (V3 WA-01) ─────────────────────────────────
# Jeton partagé validé lors du handshake GET /channels/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Secret d'application Meta : signature X-Hub-Signature-256 de chaque webhook
WHATSAPP_APP_SECRET=

# Moteur géospatial et pédologique (Python) — voir geoai/README.md
GEOAI_URL=http://127.0.0.1:8100
GEOAI_TIMEOUT_MS=20000
GEOAI_TOKEN=
GEOAI_RETRIES=1
# ─── Réseau LoRaWAN (broker MQTT ChirpStack) ───────────────
# Secrets uniquement. La structure du réseau (topics, plan de fréquence,
# qualité de service) et le catalogue des capteurs sont dans le fichier de
# configuration matériel : src/config/hardware.js — seule source de vérité.
# Laisser vide tant qu'aucun matériel n'est connecté.
LORAWAN_MQTT_URL=
LORAWAN_MQTT_USERNAME=
LORAWAN_MQTT_PASSWORD=
# Données simulées — matériel géospatial pas encore installé.
# true  : les écritures marquées SIMULATED sont acceptées (development / test).
# false : refusées.
# En production le refus est dur : cette variable ne peut pas rouvrir la porte
# (voir simulationAllowed dans src/config/env.js).
SIMULATION_ENABLED=true
# Lot de référentiel agronomique lu par le moteur de recommandation.
# 'production' en exploitation ; les tests utilisent 'test' (même table,
# jamais lues par le moteur de production, jamais dans prisma/seed.js).
AGRONOMIC_DATASET=production
# Version du moteur de recommandation (voir src/modules/recommendation/engineVersions.js).
# 2.0 = score gradué sur quatre limites + facteur le plus limitant (défaut).
# 1.0 = verdict binaire + moyenne. Une version inconnue est refusée, pas remplacée.
RECOMMENDATION_ENGINE_VERSION=2.0
# Couverture nuageuse (%) au-delà de laquelle une scène satellite OPTIQUE est
# refusée pour l'humidité du sol. Sans effet sur Sentinel-1 (radar), qui
# traverse les nuages — c'est la source principale sur ce déploiement.
SATELLITE_CLOUD_REJECT_PCT=40

# ── Acquisition satellite programmée ──────────────────────────────────────
# Fournisseur de scènes. `simulated` produit des scènes marquées SIMULATED et
# est REFUSÉ en production. Changer de fournisseur ne demande aucune
# modification de code : voir src/integrations/satellite.js.
SATELLITE_PROVIDER=simulated     # simulated | sentinelhub | earthengine | webhook
# Secrets du fournisseur. Obligatoires pour tout fournisseur réel : sans eux,
# l'acquisition échoue explicitement plutôt que de produire une valeur inventée.
SATELLITE_API_URL=
SATELLITE_API_KEY=
# Activation du job `satellite.acquire`. Faux par défaut : sans identifiants,
# un job actif ne produirait que du bruit.
SATELLITE_ACQUISITION_ENABLED=false
# Cadence de SONDAGE du fournisseur (heures), distincte de la période de
# revisite du satellite : interroger l'API chaque jour est normal quand un
# produit Sentinel-1 n'apparaît que tous les 6 à 12 jours.
SATELLITE_REFRESH_HOURS=24

# ── Détection d'anomalies sur les mesures de sonde ──────────────────────
# Active le job `sensors.detectAnomalies`. Les SEUILS ne sont pas ici : ils
# vivent dans src/config/hardware.js (section `anomalies`), marqués PROVISOIRE
# et à recaler sur les données réelles du pilote.
ANOMALY_DETECTION_ENABLED=false
NOTIFICATION_RETENTION_DAYS=90
# Délai minimal (heures) entre deux notifications d'une même alerte encore
# ouverte. Une alerte par paramètre et par épisode ; ce réglage espace les
# rappels. 0 = aucune relance, l'alerte reste visible dans l'application.
# PROVISOIRE : 24 h par défaut, à ajuster avec les coopératives pilotes.
ALERT_RENOTIFY_HOURS=24

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# URL publique du front (liens email, QR codes, partage)
PUBLIC_WEB_URL=http://localhost:5173

# ─── Base de données (Supabase Postgres) ───────────────────────
# Connection string "pooler" (port 6543) pour l'application
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe (port 5432) utilisée par les migrations Prisma
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
# Uniquement côté serveur — ne jamais exposer au front (SEC-08)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_BUCKET_MEDIA="media"
SUPABASE_BUCKET_PRIVATE="private-documents"

# ── Stockage des fichiers géospatiaux déposés (géoradar, imagerie drone) ─────
# `local` = écrit sur disque (tests, développement) ; `object` = stockage objet
# (production). Un pilote inconnu est une erreur de configuration, pas un repli
# silencieux sur `local` : en production, écrire sur le disque d'un conteneur
# éphémère ferait perdre les fichiers au redémarrage.
GEOSPATIAL_STORAGE_DRIVER=local
# Doit pointer HORS de tout dossier public. Un fichier déposé par un utilisateur
# n'est pas une ressource web : le pilote local refuse de démarrer sous
# public/, dist/, build/, static/ ou www/.
GEOSPATIAL_STORAGE_DIR=./storage/geospatial
# Panier utilisé quand GEOSPATIAL_STORAGE_DRIVER=object.
GEOSPATIAL_BUCKET=geospatial-imports
# Plafond CUMULÉ de stockage par organisation, en octets (défaut 5 Go). 0
# désactive le contrôle. Le refus de doublon ne borne rien à lui seul : il
# suffit de changer un octet pour déposer un fichier « nouveau ».
GEOSPATIAL_ORG_QUOTA_BYTES=5368709120

# ─── Intégrations (providers "console" en développement) ───────
SMS_PROVIDER=console            # console | twilio | africastalking | webhook
SMS_API_KEY=
SMS_SENDER=AGRIKONNECT
# Passerelle générique (SMS_PROVIDER=webhook) : l'API poste {to, message} sur cette URL
# Facultatif — une valeur vide est acceptée (variable non configurée).
SMS_WEBHOOK_URL=

# ── Twilio (étape E) ────────────────────────────────────────────────
# Secrets : uniquement ici. Jamais dans le code, jamais dans les journaux.
# TWILIO_AUTH_TOKEN sert aussi à vérifier la signature des webhooks :
# sa fuite permettrait de forger des accusés de remise.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Identifiant d'expéditeur ALPHANUMÉRIQUE (11 caractères max, au moins une
# lettre, identifiant générique déconseillé). En RDC l'identifiant NUMÉRIQUE
# n'est pas remis par le réseau Airtel.
TWILIO_SENDER_ID=AGRIKONNECT
# Laisser vide en production. Les tests pointent cette variable vers un faux
# serveur HTTP : c'est la seule façon d'exercer l'envoi sans compte réel.
TWILIO_API_BASE_URL=https://api.twilio.com
# Accusé de remise, à déclarer dans la console Twilio.
# Facultatif — une valeur vide est acceptée (variable non configurée).
TWILIO_STATUS_CALLBACK_URL=
# URL publique du webhook, telle que déclarée chez Twilio. L'URL fait partie du
# matériel signé : derrière un mandataire qui termine le TLS, la reconstruire
# depuis la requête peut échouer. Vide = reconstruction via X-Forwarded-*.
# Facultatif — une valeur vide est acceptée (variable non configurée).
TWILIO_WEBHOOK_BASE_URL=
TWILIO_REQUEST_TIMEOUT_MS=10000

# ── Garde-fous de coût SMS ──────────────────────────────────────────
# Le SMS est payant et c'est le canal primaire : un lot d'alertes mal réglé
# se traduit directement en facture. 0 = pas de plafond.
SMS_DAILY_LIMIT_PER_FARMER=5
SMS_DAILY_LIMIT_PER_ORGANIZATION=500
SMS_ALERT_PURPOSE=ALERT
EMAIL_PROVIDER=console          # console | resend | sendgrid | webhook
EMAIL_API_KEY=
EMAIL_FROM=no-reply@agrikonnect.africa
# Passerelle générique (EMAIL_PROVIDER=webhook) : l'API poste {to, subject, body} sur cette URL
# Facultatif — une valeur vide est acceptée (variable non configurée).
EMAIL_WEBHOOK_URL=

# ─── Règles métier (paramétrables, aucune valeur en dur) ───────
OTP_TTL_MINUTES=10
OTP_MAX_SENDS_PER_HOUR=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
ACCESS_TOKEN_TTL_MINUTES=15
SIGNED_URL_TTL_SECONDS=300
# Précision de la position publique (2 décimales ≈ 1,1 km)
PUBLIC_COORD_DECIMALS=2

# ─── Quotas V5 (API publique & IA) ────────────────────────────
# Appels quotidiens autorisés par client API (API-01/API-04)
API_DAILY_QUOTA=1000
# Analyses IA par utilisateur / par organisation sur 24 h (AI-06)
AI_DAILY_QUOTA_PER_USER=50
AI_DAILY_QUOTA_PER_ORG=500

# ─── Seuils métier V3/V5 ──────────────────────────────────────
# Seuil minimal de k-anonymat si le produit de données n'en déclare pas (DATA-02)
AGGREGATE_MIN_GROUP_SIZE=10
# Durée de validité par défaut d'un accès data room (jours) — V4
DATAROOM_ACCESS_TTL_DAYS=30
# ─── Fenêtre de silence SMS ───────────────────────────────────
# Aucune ALERTE n'est envoyée pendant cette plage ; elle est retenue avec la
# raison QUIET_HOURS, comptée dans `SmsBatchLog.skippedByReason`, et repart au
# passage suivant. Les OTP ne sont JAMAIS concernés : un code de vérification
# retenu la nuit rendrait la connexion impossible.
SMS_QUIET_HOURS_ENABLED=false
# Heures locales au fuseau ci-dessous. La plage peut traverser minuit
# (21:00 → 06:00). Début == fin signifie « aucune fenêtre ».
SMS_QUIET_START=21:00
SMS_QUIET_END=06:00
# Fuseau de référence. La RDC en couvre deux (Kinshasa UTC+1, Lubumbashi
# UTC+2) et rien ne résout aujourd'hui le fuseau par destinataire : ce réglage
# s'applique à tout le monde. Un fuseau inconnu fait échouer l'envoi plutôt que
# de retomber silencieusement sur l'heure du serveur.
SMS_DEFAULT_TIMEZONE=Africa/Kinshasa

# ─── Escalade des alertes à deux niveaux ──────────────────────
# Une alerte de niveau 1 non traitée après ce délai est renvoyée aux rôles
# d'escalade. Le délai court depuis `notifiedAt`, pas depuis la dernière
# re-notification — sinon une re-notification repousserait l'escalade
# indéfiniment.
ALERT_ESCALATION_ENABLED=true
ALERT_ESCALATION_DELAY_MINUTES=120
# Rôles destinataires du niveau 2, séparés par des virgules.
ALERT_ESCALATION_ROLES=AGRONOMIST,SUPER_ADMIN

# ─── Dépôt géospatial : tailles acceptées ─────────────────────
# Corps JSON brut maximal (GeoJSON, CSV) — octets.
GEOSPATIAL_JSON_MAX_BYTES=104857600
# Téléversement multipart maximal (Shapefile, GeoTIFF, SEG-Y) — 64 Mo.
# Le plafond est appliqué PENDANT la lecture du flux, pas après : un fichier
# trop volumineux est interrompu au lieu d'être entièrement chargé en mémoire.
GEOSPATIAL_MULTIPART_MAX_BYTES=67108864

# ─── Stockage objet compatible S3 (pilote `s3`) ───────────────
# À renseigner uniquement si GEOSPATIAL_STORAGE_DRIVER=s3. Avec `local`, ces
# variables sont ignorées. Fonctionne avec AWS S3, MinIO, Scaleway, OVH…
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` pour les serveurs compatibles dont le bucket fait partie du chemin
# (http://hote/bucket/cle) plutôt que du nom d'hôte (http://bucket.hote/cle).
# C'est le cas de MinIO et de la plupart des installations auto-hébergées.
S3_PATH_STYLE=false

# ─── Repli d'expéditeur SMS (optionnel, déconseillé) ──────────
# Numéro E.164 depuis lequel repartir si l'identifiant alphanumérique est refusé
# (codes Twilio 30018 / 30040).
#
# LAISSER VIDE PAR DÉFAUT. Sans cette variable, un refus de l'alphanumérique
# reste un refus et sa raison est journalisée — aucune bascule silencieuse.
# L'agriculteur reconnaît l'expéditeur de ses alertes, et en RDC les identifiants
# NUMÉRIQUES NE SONT PAS REMIS PAR AIRTEL : un repli numérique ferait arriver le
# message chez certains opérateurs et pas chez d'autres, sans signe visible.
TWILIO_FALLBACK_FROM=

# ─── E-mail de vérification ───────────────────────────────────
# EMAIL_PROVIDER=resend ou sendgrid exige EMAIL_API_KEY, sinon le démarrage est
# refusé : sans elle, aucun e-mail de vérification ne part et l'inscription reste
# bloquée à l'étape de confirmation.
#
# Vérifier la configuration sans envoyer de message :
#   npm run email:verifier-config
EMAIL_VERIFIED_DOMAINS=
# Domaines vérifiés chez le fournisseur, séparés par des virgules
# (ex. agrikonnect.africa). Vide = aucun contrôle. Un domaine d'exemple
# (example.com, localhost) est toujours refusé.
EMAIL_REQUEST_TIMEOUT_MS=10000

# ─── URL des API e-mail ───────────────────────────────────────
# À ne changer que pour tester contre un faux serveur HTTP. En production, laisser
# les valeurs par défaut.
RESEND_API_BASE_URL=https://api.resend.com
SENDGRID_API_BASE_URL=https://api.sendgrid.com





# Stockage des images d'articles de blog (Cloudinary)
CLOUDINARY_CLOUD_NAME=naplilnj
CLOUDINARY_API_KEY=121566489946831
CLOUDINARY_API_SECRET=svS51qfVUMjJv_qJITvuFkVkwvc



CONTACT_EMAIL=doroosee45@gmail.com
RESEND_API_KEY=
MAIL_FROM="Omedev services <noreply@www-omedevservices.net>"
