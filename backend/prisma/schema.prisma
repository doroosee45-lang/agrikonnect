  MATCHED
  CLOSED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// Machine à états stricte (CDC V2 §5.5 / §8.4)
enum OrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  READY
  IN_TRANSIT
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  DECLARED_UNPAID
  DECLARED_PAID
}

enum InventoryMovementType {
  IN
  OUT
  LOSS
  TRANSFER
  INVENTORY
  RESERVATION
  RELEASE
}

enum ShipmentStatus {
  REQUESTED
  OFFERED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  ARCHIVED
  BLOCKED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

/// État de remise d'un SMS, tel que rapporté par le fournisseur.
///
/// Les valeurs suivent celles de l'API Twilio (`queued`, `sent`, `delivered`,
/// `undelivered`, `failed`, …) mises en majuscules, plus `QUEUED_LOCALLY` pour
/// l'état avant acceptation par le fournisseur. **`ACCEPTED` ne veut pas dire
/// « reçu »** : c'est la distinction que le suivi de remise existe pour faire.
enum SmsDeliveryStatus {
  /// Créé en base, pas encore soumis au fournisseur.
  QUEUED_LOCALLY
  /// Accepté par le fournisseur : en file chez lui, pas encore remis.
  QUEUED
  SENT
  /// Remis au terminal, d'après l'accusé du réseau.
  DELIVERED
  /// Le réseau a répondu qu'il n'a pas pu remettre.
  UNDELIVERED
  FAILED
  /// État inconnu : le fournisseur a renvoyé une valeur non reconnue.
  /// On ne la devine pas, on la conserve et on la signale.
  UNKNOWN
}

/// Consentement explicite à recevoir des SMS pour un usage donné.
///
/// Nécessaire parce que l'identifiant d'expéditeur alphanumérique est **à sens
/// unique** : le destinataire ne peut pas répondre « STOP ». La désinscription
/// doit donc exister dans l'application, et son historique doit être prouvable.
enum SmsConsentStatus {
  GRANTED
  WITHDRAWN
}

/// Raison pour laquelle un SMS n'a pas été envoyé.
enum SmsSkipReason {
  /// Aucun consentement pour cet usage.
  NO_CONSENT
  /// Consentement retiré.
  CONSENT_WITHDRAWN
  /// Plafond de SMS par agriculteur et par jour atteint.
  DAILY_LIMIT
  /// Alertes SMS désactivées dans les préférences.
  PREFERENCE_DISABLED
  /// Pas de numéro de téléphone exploitable.
  NO_PHONE
  /// Numéro jamais confirmé par son titulaire.
  ///
  /// Une alerte partie vers un numéro non confirmé peut atteindre un inconnu
  /// (faute de frappe à l'inscription, numéro réattribué). Le canal étant à
  /// sens unique en RDC, il n'y a aucun « STOP » possible : la vérification
  /// préalable est la seule protection.
  PHONE_UNVERIFIED
  /// Envoi retenu par la fenêtre de silence (heures diurnes).
  ///
  /// Une alerte arrivée de nuit est reportée, pas perdue : le lot suivant la
  /// reprend. La raison est comptée séparément pour qu'un volume retenu la nuit
  /// ne se confonde pas avec un refus de consentement.
  QUIET_HOURS
}

enum InvoiceType {
  QUOTE
  PROFORMA
  INVOICE
  RECEIPT
  DELIVERY_NOTE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  WITHDRAWN
}

/// Idempotence des créations sensibles (CDC §13.2)
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  scope          String
  userId         String?
  requestHash    String?
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Listing {
  id              String        @id
  organizationId  String        @map("organization_id")
  type            ListingType
  cropId          String?       @map("crop_id")
  title           String
  description     String?
  quantity        Float
  unit            String
  quality         String?
  indicativePrice Float?        @map("indicative_price")
  currency        String        @default("USD")
  countryCode     String        @map("country_code") @db.Char(2)
  province        String?
  latitude        Float?
  longitude       Float?
  availableFrom   DateTime?     @map("available_from")
  availableTo     DateTime?     @map("available_to")
  certifications  String[]
  conditions      String?
  status          ListingStatus @default(DRAFT)
  source          Source        @default(declared)
  expiresAt       DateTime?     @map("expires_at")
  createdBy       String?       @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  version         Int           @default(1)

  media Media[]

  @@index([status, cropId, countryCode])
  @@index([organizationId, status])
  @@index([latitude, longitude])
  @@map("listings")
}

model PurchaseRequest {
  id               String                @id
  buyerOrgId       String                @map("buyer_org_id")
  cropId           String                @map("crop_id")
  title            String
  description      String?
  quantity         Float
  unit             String
  quality          String?
  budgetPrice      Float?                @map("budget_price")
  currency         String                @default("USD")
  deliveryCountry  String                @map("delivery_country") @db.Char(2)
  deliveryProvince String?               @map("delivery_province")
  neededBy         DateTime?             @map("needed_by")
  conditions       String?
  status           PurchaseRequestStatus @default(OPEN)
  createdBy        String?               @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")
  version          Int                   @default(1)

  @@index([status, cropId, neededBy])
  @@index([buyerOrgId, status])
  @@map("purchase_requests")
}

model Offer {
  id          String      @id
  requestId   String?     @map("request_id")
  listingId   String?     @map("listing_id")
  sellerOrgId String      @map("seller_org_id")
  price       Float
  currency    String      @default("USD")
  quantity    Float
  unit        String
  conditions  String?
  status      OfferStatus @default(PENDING)
  validUntil  DateTime?   @map("valid_until")
  createdBy   String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([requestId, status])
  @@index([listingId, status])
  @@index([sellerOrgId])
  @@map("offers")
}

model Order {
  id            String        @id
  number        String
  buyerOrgId    String        @map("buyer_org_id")
  sellerOrgId   String        @map("seller_org_id")
  listingId     String?       @map("listing_id")
  requestId     String?       @map("request_id")
  offerId       String?       @map("offer_id")
  /// Conditions figées à la création (CDC V2 P2 : snapshot)
  snapshot      Json
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(DECLARED_UNPAID)
  delivery      Json?
  totalAmount   Float?        @map("total_amount")
  currency      String        @default("USD")
  placedBy      String?       @map("placed_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")
  version       Int           @default(1)

  events   OrderEvent[]
  dispute  Dispute?
  invoices Invoice[]
  reviews  Review[]

  @@unique([number])
  @@index([buyerOrgId, status])
  @@index([sellerOrgId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String       @map("order_id")
  from       OrderStatus? @map("from_status")
  to         OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id")
  actorOrgId String?      @map("actor_org_id")
  reason     String?
  at         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_events")
}

model InventoryItem {
