/// Journal d'événements : le solde est DÉRIVÉ, jamais stocké en dur (STK-01)
model InventoryMovement {
  id             String                @id
  organizationId String                @map("organization_id")
  itemId         String                @map("item_id")
  type           InventoryMovementType
  quantity       Float
