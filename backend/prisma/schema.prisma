enum AiAnalysisType {
  CHAT
  PLANT_PHOTO
  DOCUMENT
}

enum AiAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  ESCALATED
}

enum LotStatus {
  OPEN
  CLOSED
  RECALLED
}

enum LotEventType {
  HARVEST
  STORAGE
  PROCESSING
  TRANSPORT
  DELIVERY
  /// TRC-02 — rappel de lot : événement dédié, jamais confondu avec « OTHER ».
  RECALL
  OTHER
}

enum CertificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum PriceSourceType {
