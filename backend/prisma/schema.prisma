  createdAt      DateTime              @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId, itemId, at])
  @@index([refType, refId])
  @@map("inventory_movements")
}

model TransportRequest {
