// =============================================================
// AGRIKONNECT AFRICA — Schéma Prisma (Postgres / Supabase)
// Périmètre : V1 (FARM) + socle Soil S1 + préparation V2→V5
// Conventions CDC §12.1 : id (ULID client-possible), countryCode,
// createdAt, updatedAt, createdBy, deletedAt (soft delete), version, source
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────────────────────

/// CDC §3.2 — rôles RBAC
enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT_AGENT
  FARMER
  COOPERATIVE_ADMIN
  COOPERATIVE_MEMBER
  AGRICULTURAL_COMPANY
  BUYER
  SUPPLIER
  TRANSPORTER
  AGRONOMIST
  INVESTOR
  LAB_PARTNER
  API_CLIENT
  PUBLIC_USER
  // V4 — vérificateur professionnel (juriste, auditeur, agronome missionné)
  VERIFIER
  // V5 — administration par pays et gouvernance des données
  COUNTRY_ADMIN
  DATA_STEWARD
}

/// Tenant = Organisation (CDC §3.4 / A.3)
enum OrgType {
  INDIVIDUAL
  COOPERATIVE
  COMPANY
}

/// CDC §2 P2 — provenance de la donnée
enum Source {
  declared
  platform_verified
  third_party_verified
  measured_lab
  measured_sensor
  estimated
  derived
  satellite
  photo_interpreted
  /// Profil de sous-sol mesuré au GPR (tarière/carottage/SEG-Y).
  measured_gpr
  /// Produit d'un modèle d'IA : jamais présenté comme une mesure.
  model_predicted
}

/// CDC PROF-02 — visibilité par champ
enum Visibility {
  public
  onRequest
  private
}

/// CDC VER-01 — niveaux de vérification
enum VerificationLevel {
  PHONE_VERIFIED
  PROFILE_VERIFIED
  ORGANIZATION_VERIFIED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// PLOT-01
enum PlotStatus {
  FALLOW
  PLANTED
  GROWING
  HARVESTED
  RESTING
}

enum GeometryType {
  POINT
  POLYGON
}

enum CropStatus {
  DRAFT
  VALIDATED
  ARCHIVED
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum Confidentiality {
  PRIVATE
  RESTRICTED
  PUBLIC
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum CountryStatus {
  PLANNED
  PILOT
  ACTIVE
  SUSPENDED
}

/// CDC §11.3 — niveau de confiance
enum Confidence {
  low
  medium
  high
}

enum OtpPurpose {
  PHONE_VERIFICATION
  LOGIN
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  COOPERATIVE_INVITATION
  AGENT_CONSENT
}

// ─────────────────────────────────────────────────────────────
// IDENTITÉ & TENANCY
// ─────────────────────────────────────────────────────────────

/// Profil applicatif. `id` = id de l'utilisateur Supabase Auth.
model Profile {
  id                  String    @id @db.Uuid
  email               String    @unique
  emailVerifiedAt     DateTime? @map("email_verified_at")
  phone               String?   @unique
  phoneVerifiedAt     DateTime? @map("phone_verified_at")
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  whatsapp            String?
  locale              String    @default("fr")
  countryCode         String    @map("country_code") @db.Char(2)
  status              String    @default("ACTIVE")
  avatarUrl           String?   @map("avatar_url")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  /// V4 NFR-01 — second facteur réellement exigé à la connexion (miroir de MfaSecret.confirmedAt)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditActor")

  @@index([countryCode])
  @@map("profiles")
}

model Organization {
  id          String    @id
  type        OrgType   @default(INDIVIDUAL)
  name        String
  slug        String?   @unique
  description String?
  countryCode String    @map("country_code") @db.Char(2)
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)

  memberships     Membership[]
  farms           Farm[]
  plots           Plot[]
  productions     Production[]
  cooperative     Cooperative?
  documents       Document[]
  media           Media[]
  soilAssessments SoilAssessment[]
  soilDiagnostics SoilDiagnostic[]

  recommendations  CropRecommendation[]
  alerts           ThresholdAlert[]
  predictions      SoilPrediction[]
  interpolatedMaps InterpolatedMap[]
  sensorAnomalies  SensorAnomaly[]
  seasonFeedback   SeasonFeedback[]
  aiModels         AiModelVersion[]
  imports          GeospatialImport[]
  agronomicRanges  CropAgronomicRange[]

  @@index([type])
  @@index([countryCode])
  @@map("organizations")
}

/// Rôle(s) d'un utilisateur dans une organisation + consentements délégués

/// Occupation cumulée d'une ressource par organisation.
///
/// ## Pourquoi cette table existe
///
/// Contrôler un quota avec `aggregate` puis créer la ligne est une course :
/// deux dépôts arrivés en même temps lisent la même somme et passent **tous les
/// deux**, puis dépassent le plafond. Le compteur est incrémenté **dans la
/// transaction du dépôt** : la ligne est verrouillée, le second dépôt attend le
/// commit du premier et voit la somme mise à jour.
///
/// `BigInt` et non `Int` : le quota par défaut est de 5 Go, au-delà de ce
/// qu'un entier 32 bits peut porter.
model ResourceUsage {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// Ressource comptée, par exemple `GEOSPATIAL_IMPORT`.
  resource       String
  usedBytes      BigInt   @default(0) @map("used_bytes")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, resource])
  @@index([organizationId])
  @@map("resource_usages")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String           @db.Uuid
  organizationId String
  roles          Role[]
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  createdBy      String?          @map("created_by")
  /// Portée des données autorisées à la coopérative (COOP-05 / §3.3)
  consentScopes  Json?            @map("consent_scopes")

  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

// ─────────────────────────────────────────────────────────────
// RÉFÉRENTIELS
// ─────────────────────────────────────────────────────────────

/// GLB-01 — configuration pays (aucune donnée en dur)
model Country {
  code              String        @id @db.Char(2)
  name              String
  currencies        String[]
  defaultCurrency   String        @default("USD") @map("default_currency")
  locales           String[]
  timezone          String
  adminLevels       Json?         @map("admin_levels")
  units             Json?
  complianceProfile Json?         @map("compliance_profile")
  /// GLB-03 / V5:NFR-04 — résidence des données exigée par le pays :
  /// { region, provider, attestationRef, verifiedAt }.
  hosting           Json?
  status            CountryStatus @default(PLANNED)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("countries")
}

/// CROP-01 / CROP-02 — catalogue administré
model Crop {
  id        String     @id
  slug      String     @unique
  category  String
  /// { "fr": "Manioc", "en": "Cassava", "ln": "..." }
  names     Json
  cycleDays Int?       @map("cycle_days")
  seasons   Json?
  units     Json?
  /// Fiche agronomique (S2) : pH optimal, eau, altitude, texture, précédents
  agronomy  Json?
  status    CropStatus @default(VALIDATED)
  source    Source     @default(declared)
  createdBy String?    @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  version   Int        @default(1)

  farms          FarmCrop[]
  plots          Plot[]
  histories      PlotCropHistory[]
  productions    Production[]
  seasonFeedback SeasonFeedback[]

  @@index([category, status])
  @@map("crops")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Journal immuable des changements de paramètres (SPEC-SUPER-ADMIN M3).
/// Insertion seule : aucune mise à jour ni suppression applicatives ;
/// la rétention est une purge de maintenance SUPER_ADMIN, elle-même auditéee.
model SettingRevision {
  id            String   @id @default(cuid())
  key           String
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  changedBy     String?  @db.Uuid @map("changed_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("settings_revisions")
}

// ─────────────────────────────────────────────────────────────
// EXPLOITATIONS & PARCELLES
// ─────────────────────────────────────────────────────────────

model Farm {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  slug           String   @unique
  /// Ancien slug conservé pour redirection (PUB-02)
  previousSlugs  String[] @default([]) @map("previous_slugs")
  description    String?
  countryCode    String   @map("country_code") @db.Char(2)
  province       String?
  territory      String?
  sector         String?
  village        String?

  /// Position exacte (privée) — GeoJSON { type: 'Point', coordinates: [lng, lat] }
  location                Json?
  latitude                Float?
  longitude               Float?
  /// Position publique approximative (MAP-04) — calculée côté serveur
  publicLatitude          Float? @map("public_latitude")
  publicLongitude         Float? @map("public_longitude")
  publicLocationPrecision String @default("approximate") @map("public_location_precision")

  totalAreaHa Float?  @map("total_area_ha")
  workers     Int?
  capacity    String?
  foundedYear Int?    @map("founded_year")

  /// { "phone": "private", "email": "private", "location": "approximate" } (PROF-02)
  visibility Json    @default("{}")
  isPublic   Boolean @default(false) @map("is_public")
  viewCount  Int     @default(0) @map("view_count")

  verificationStatus VerificationLevel? @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         String?            @map("verified_by")

  source    Source    @default(declared)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plots        Plot[]
  crops        FarmCrop[]
  productions  Production[]
  media        Media[]

  @@index([countryCode, province])
  @@index([latitude, longitude])
  @@index([isPublic, deletedAt])
  @@index([organizationId])
  @@map("farms")
}

model FarmCrop {
  farmId String @map("farm_id")
  cropId String @map("crop_id")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@id([farmId, cropId])
  @@map("farm_crops")
}

model Plot {
  id             String       @id
  organizationId String       @map("organization_id")
  farmId         String       @map("farm_id")
  name           String
  areaHa         Float?       @map("area_ha")
  geometryType   GeometryType @default(POINT) @map("geometry_type")
  /// GeoJSON Point ou Polygon
  geometry       Json
  /// Centroïde pour filtrage bbox / index
  latitude       Float?
  longitude      Float?

  currentCropId String?    @map("current_crop_id")
  plantingDate  DateTime?  @map("planting_date")
  status        PlotStatus @default(FALLOW)

  source    Source    @default(declared)
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm            Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  currentCrop     Crop?             @relation(fields: [currentCropId], references: [id])
  histories       PlotCropHistory[]
  productions     Production[]
  media           Media[]
  soilAssessments SoilAssessment[]
  soilDiagnostics SoilDiagnostic[]

  recommendations  CropRecommendation[]
  alerts           ThresholdAlert[]
  predictions      SoilPrediction[]
  interpolatedMaps InterpolatedMap[]
  seasonFeedback   SeasonFeedback[]
  imports          GeospatialImport[]

  @@index([organizationId, farmId])
  @@index([farmId, deletedAt])
  @@index([latitude, longitude])
  @@map("plots")
}

/// PLOT-03 — historique cultural (base du module Soil)
model PlotCropHistory {
  id             String    @id
  organizationId String    @map("organization_id")
  plotId         String    @map("plot_id")
  season         String
  year           Int
  cropId         String    @map("crop_id")
  plantedAt      DateTime? @map("planted_at")
  harvestedAt    DateTime? @map("harvested_at")
  declaredYield  Float?    @map("declared_yield")
  unit           String?
  notes          String?
  source         Source    @default(declared)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)
  crop Crop @relation(fields: [cropId], references: [id])

  @@index([plotId, year, season])
  @@map("plot_crop_history")
}

// ─────────────────────────────────────────────────────────────
// PRODUCTIONS
// ─────────────────────────────────────────────────────────────

model Production {
  id             String    @id
  organizationId String    @map("organization_id")
  farmId         String    @map("farm_id")
  plotId         String?   @map("plot_id")
  cropId         String    @map("crop_id")
  harvestedAt    DateTime  @map("harvested_at")
  season         String
  quantity       Float
  unit           String
  quantityKg     Float?    @map("quantity_kg")
  quality        String?
  destination    String?
  source         Source    @default(declared)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot         Plot?        @relation(fields: [plotId], references: [id])
  crop         Crop         @relation(fields: [cropId], references: [id])

  @@index([organizationId, cropId, harvestedAt])
  @@index([plotId, harvestedAt])
  @@map("productions")
}

// ─────────────────────────────────────────────────────────────
// COOPÉRATIVES
// ─────────────────────────────────────────────────────────────

model Cooperative {
  id             String    @id
  organizationId String    @unique @map("organization_id")
  legalStatus    String?   @map("legal_status")
  foundedYear    Int?      @map("founded_year")
  description    String?
  province       String?
  territory      String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      CooperativeMember[]

  @@map("cooperatives")
}

model CooperativeMember {
  id                   String           @id @default(cuid())
  cooperativeId        String           @map("cooperative_id")
  memberUserId         String           @map("member_user_id") @db.Uuid
  memberOrganizationId String?          @map("member_organization_id")
  status               MembershipStatus @default(INVITED)
  joinedAt             DateTime?        @map("joined_at")
  invitedBy            String?          @map("invited_by")
  /// Portée du consentement : ['profile','plots','productions']
  consentScopes        String[]         @default([]) @map("consent_scopes")
  consentRecordedAt    DateTime?        @map("consent_recorded_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)

  @@unique([cooperativeId, memberUserId])
  @@index([memberUserId])
  @@map("cooperative_members")
}

// ─────────────────────────────────────────────────────────────
// MÉDIAS & DOCUMENTS
// ─────────────────────────────────────────────────────────────

model Media {
  id             String    @id
  organizationId String    @map("organization_id")
  farmId         String?   @map("farm_id")
  plotId         String?   @map("plot_id")
  /// V2 — photos d'annonce marketplace
  listingId      String?   @map("listing_id")
  kind           MediaKind @default(PHOTO)
  storageKey     String    @map("storage_key")
  url            String?
  mimeType       String    @map("mime_type")
  sizeBytes      Int?      @map("size_bytes")
  width          Int?
  height         Int?
  caption        String?
  position       Int       @default(0)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm         Farm?        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  plot         Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([farmId, position])
  @@index([plotId, position])
  @@index([listingId, position])
  @@map("media")
}

model Document {
  id              String          @id
  organizationId  String          @map("organization_id")
  name            String
  category        String?
  storageKey      String          @map("storage_key")
  mimeType        String          @map("mime_type")
  sizeBytes       Int?            @map("size_bytes")
  sha256          String?
  confidentiality Confidentiality @default(PRIVATE)
  uploadedBy      String?         @map("uploaded_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  deletedAt       DateTime?       @map("deleted_at")

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications VerificationDocument[]

  @@index([organizationId, category])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────
// VÉRIFICATION & MODÉRATION
// ─────────────────────────────────────────────────────────────

model Verification {
  id             String             @id
  subjectType    String             @map("subject_type")
  subjectId      String             @map("subject_id")
  organizationId String             @map("organization_id")
  level          VerificationLevel
  status         VerificationStatus @default(PENDING)
  reason         String?
  reviewedBy     String?            @map("reviewed_by")
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  documents VerificationDocument[]

  @@index([status, createdAt])
  @@index([subjectType, subjectId])
  @@map("verifications")
}

model VerificationDocument {
  verificationId String @map("verification_id")
  documentId     String @map("document_id")

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([verificationId, documentId])
  @@map("verification_documents")
}

model Report {
  id          String       @id
  reporterId  String       @map("reporter_id") @db.Uuid
  subjectType String       @map("subject_type")
  subjectId   String       @map("subject_id")
  reason      String
  details     String?
  status      ReportStatus @default(OPEN)
  moderatorId String?      @map("moderator_id")
  decision    String?
  decidedAt   DateTime?    @map("decided_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────
// JOURNAL D'AUDIT (append-only) — SEC-09
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id") @db.Uuid
  actingFor  String?  @map("acting_for") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ip         String?
  device     String?
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([resource, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// AUTH APPLICATIVE (OTP, jetons)
// ─────────────────────────────────────────────────────────────

model OtpCode {
  id         String     @id @default(cuid())
  identifier String
  userId     String?    @map("user_id") @db.Uuid
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose @default(PHONE_VERIFICATION)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose, createdAt])
  @@map("otp_codes")
}

model Token {
  id         String       @id @default(cuid())
  userId     String?      @map("user_id") @db.Uuid
  identifier String?
  tokenHash  String       @map("token_hash")
  purpose    TokenPurpose
  expiresAt  DateTime     @map("expires_at")
  consumedAt DateTime?    @map("consumed_at")
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([identifier, purpose])
  @@map("tokens")
}

// ─────────────────────────────────────────────────────────────
// SOIL & CROP INTELLIGENCE — S1 (CDC §11 / V1 §6)
// ─────────────────────────────────────────────────────────────

model SoilAssessment {
  id             String    @id
  organizationId String    @map("organization_id")
  plotId         String    @map("plot_id")
  assessedAt     DateTime  @map("assessed_at")
  countryCode    String    @map("country_code") @db.Char(2)
  notes          String?
  source         Source    @default(declared)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plot         Plot            @relation(fields: [plotId], references: [id], onDelete: Cascade)
  parameters   SoilParameter[]

  @@index([plotId, assessedAt])
  @@map("soil_assessments")
}

