  currency    String
  unit        String
  observedAt  DateTime        @map("observed_at")
  source      PriceSourceType @default(AGENT)
  sourceLabel String?         @map("source_label")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([cropId, market, observedAt])
  @@index([countryCode, observedAt])
