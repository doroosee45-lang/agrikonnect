  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  collection     String
  operation      String
  entityId       String   @map("entity_id")
  payload        Json?
  result         String   @default("APPLIED")
  conflict       Json?
  appliedAt      DateTime @default(now()) @map("applied_at")

  @@index([organizationId, appliedAt])
  @@index([collection, appliedAt])
  @@map("sync_operations")
}

model AiAnalysis {
  id             String           @id
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  type           AiAnalysisType
  status         AiAnalysisStatus @default(PENDING)
  plotId         String?          @map("plot_id")
  prompt         String?
